@{
    ViewData["Title"] = "NMD Infotech AI Assistant";
}

<link rel="stylesheet" href="~/css/chat.css" asp-append-version="true" />

<div class="chat-container">
    <div class="chat-header">
        <div class="header-left">
            <div class="header-icon">
                <img src="/images/company-logo.png.png" alt="NMD" onerror="this.style.display='none'; this.parentElement.querySelector('.header-text-icon').style.display='flex';" />
                <div class="header-text-icon" style="display:none;">NMD</div>
            </div>

            <div>
                <h1>NMD AI Assistant</h1>
                <p><span class="online-dot"></span> NMD Infotech Services • Pune</p>
            </div>
        </div>

        <div class="header-actions">
            <a href="https://wa.me/919049442717?text=Hello%20NMD%20Infotech%2C%20I%20would%20like%20to%20know%20more%20about%20your%20services" target="_blank" rel="noopener noreferrer" class="header-action-btn whatsapp-btn" title="Chat on WhatsApp (+91 9049442717)" aria-label="Chat on WhatsApp">
                <svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor">
                    <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
                </svg>
                <span>WhatsApp</span>
            </a>
            <button type="button" id="downloadChatBtn" class="header-action-btn download-btn" title="Download Conversation Transcript" aria-label="Download Transcript">
                <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                    <polyline points="7 10 12 15 17 10"></polyline>
                    <line x1="12" y1="15" x2="12" y2="3"></line>
                </svg>
            </button>
            <button type="button" id="soundToggleBtn" class="header-action-btn sound-btn" title="Toggle Sound" aria-label="Toggle Sound">
                <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
                    <path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path>
                </svg>
            </button>
            <button type="button" id="clearChatBtn" class="clear-chat-btn" title="Clear Chat">
                Clear
            </button>
        </div>
    </div>  

    <div id="chatMessages" class="chat-messages">
        <div class="welcome-message">
            <div class="welcome-icon">
                <img src="/images/company-logo.png.png" alt="NMD Infotech Logo" onerror="this.src='/images/company-logo.png';" />
            </div>

            <h2>Welcome to NMD Infotech</h2>
            <p>
                I am your AI Assistant for <strong>NMD Infotech Services</strong>.<br />
                Ask me about our IT solutions, custom software, app development, or get in touch with our team!
            </p>

            <div class="suggestion-buttons">
                <button type="button" class="suggestion-chip" onclick="sendSuggestion('What services does NMD Infotech provide?')">
                    <span>Our Services</span>
                    <span class="chip-arrow">→</span>
                </button>

                <button type="button" class="suggestion-chip" onclick="sendSuggestion('Tell me about Web and App Development')">
                    <span>Web &amp; Mobile Apps</span>
                    <span class="chip-arrow">→</span>
                </button> 

                <button type="button" class="suggestion-chip" onclick="sendSuggestion('Tell me about Data Science and Analytics')">
                    <span>Data Analytics</span>
                    <span class="chip-arrow">→</span>
                </button>

                <button type="button" class="suggestion-chip" onclick="sendSuggestion('What is your office address and contact number?')">
                    <span>Contact &amp; Office</span>
                    <span class="chip-arrow">→</span>
                </button>
            </div>
        </div>
    </div>

    <div class="chat-input-wrap">
        <div class="chat-input-capsule">
            <input type="text"
                   id="userInput"
                   placeholder="Ask about our IT services, projects, or contact..."
                   autocomplete="off" />

            <div class="capsule-actions">
                <button type="button" id="micLangBtn" class="mic-lang-pill" title="व्हॉईस भाषा बदला (मराठी / English)">
                    मराठी
                </button>

                <button type="button" id="micBtn" class="mic-icon-btn" title="Voice Input (क्लिक करून बोला)" aria-label="Voice Input">
                    <svg class="mic-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3z"></path>
                        <path d="M19 10v1a7 7 0 0 1-14 0v-1"></path>
                        <line x1="12" y1="18" x2="12" y2="22"></line>
                    </svg>
                </button>

                <button type="button" id="sendBtn" class="send-circle-btn" title="Send message" aria-label="Send message">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="12" y1="19" x2="12" y2="5"></line>
                        <polyline points="5 12 12 5 19 12"></polyline>
                    </svg>
                </button>
            </div>
        </div>
        <div class="chat-footer-brand">
            <span>Powered by <strong>NMD Infotech</strong> AI</span>
        </div>
    </div>
</div>