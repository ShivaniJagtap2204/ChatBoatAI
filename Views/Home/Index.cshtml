@{
    ViewData["Title"] = "NMD Infotech AI Assistant";
}

<link rel="stylesheet" href="~/css/chat.css" asp-append-version="true" />

<div class="chat-container">
    <div class="chat-header">
        <div class="header-left">
            <div class="header-icon">
                <img src="/images/company-logo.png.png" alt="NMD" onerror="this.style.display='none'; this.parentElement.querySelector('.header-text-icon').style.display='flex';" />
                <div class="header-text-icon" style="display:none;">NMD</div>
            </div>

            <div>
                <h1>NMD AI Assistant</h1>
                <p><span class="online-dot"></span> NMD Infotech Services • Pune</p>
            </div>
        </div>

        <div class="header-actions">
            <button type="button" id="clearChatBtn" class="clear-chat-btn" title="Clear Chat">
                Clear
            </button>
        </div>
    </div>  

    <div id="chatMessages" class="chat-messages">
        <div class="welcome-message">
            <div class="welcome-icon">
                <img src="/images/company-logo.png.png" alt="NMD Infotech Logo" onerror="this.src='/images/company-logo.png';" />
            </div>

            <h2>Welcome to NMD Infotech</h2>
            <p>
                I am your AI Assistant for <strong>NMD Infotech Services</strong>.<br />
                Ask me about our IT solutions, custom software, app development, or get in touch with our team!
            </p>

            <div class="suggestion-buttons">
                <button type="button" class="suggestion-chip" onclick="sendSuggestion('What services does NMD Infotech provide?')">
                    <span>Our Services</span>
                    <span class="chip-arrow">→</span>
                </button>

                <button type="button" class="suggestion-chip" onclick="sendSuggestion('Tell me about Web and App Development')">
                    <span>Web &amp; Mobile Apps</span>
                    <span class="chip-arrow">→</span>
                </button> 

                <button type="button" class="suggestion-chip" onclick="sendSuggestion('Tell me about Data Science and Analytics')">
                    <span>Data Analytics</span>
                    <span class="chip-arrow">→</span>
                </button>

                <button type="button" class="suggestion-chip" onclick="sendSuggestion('What is your office address and contact number?')">
                    <span>Contact &amp; Office</span>
                    <span class="chip-arrow">→</span>
                </button>
            </div>
        </div>
    </div>

    <div class="chat-input-wrap">
        <div class="chat-input-capsule">
            <input type="text"
                   id="userInput"
                   placeholder="Ask about our IT services, projects, or contact..."
                   autocomplete="off" />

            <div class="capsule-actions">
                <button type="button" id="micLangBtn" class="mic-lang-pill" title="व्हॉईस भाषा बदला (मराठी / English)">
                    मराठी
                </button>

                <button type="button" id="micBtn" class="mic-icon-btn" title="Voice Input (क्लिक करून बोला)" aria-label="Voice Input">
                    <svg class="mic-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3z"></path>
                        <path d="M19 10v1a7 7 0 0 1-14 0v-1"></path>
                        <line x1="12" y1="18" x2="12" y2="22"></line>
                    </svg>
                </button>

                <button type="button" id="sendBtn" class="send-circle-btn" title="Send message" aria-label="Send message">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="12" y1="19" x2="12" y2="5"></line>
                        <polyline points="5 12 12 5 19 12"></polyline>
                    </svg>
                </button>
            </div>
        </div>
        <div class="chat-footer-brand">
            <span>Powered by <strong>NMD Infotech</strong> AI</span>
        </div>
    </div>
</div>